{
  "name": "agent-router",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.agentrouter.app",
    "productName": "AgentRouter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "portable": {
      "artifactName": "AgentRouter-${version}.exe"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vite": "^8.0.10",
    "wait-on": "^8.0.5",
    "vue-tsc": "^2.2.0"
  }
}
